// MoHAA Launcher's Windows resources: the game's gold star (the vulkan branch's misc/windows/openmohaa.ico) and
// the version. The icon comes first by name, so Explorer shows it.
#include <winver.h>

AAAA_APPICON ICON "launcher.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "MoHAA Launcher"
			VALUE "FileVersion", "1.0.0"
			VALUE "InternalName", "mohaa-launcher"
			VALUE "LegalCopyright", "GPL-3.0-or-later, MoHAA Reloaded"
			VALUE "OriginalFilename", "mohaa-launcher.exe"
			VALUE "ProductName", "MoHAA Reloaded"
			VALUE "ProductVersion", "1.0.0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
