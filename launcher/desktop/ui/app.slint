// MoHAA Launcher's window, in Slint's Fluent style (dark; build.rs picks it), as small as its contents: the games
// along the top, the player and the servers, the crosshair and the display, and the buttons. main.rs fills it and
// acts on its callbacks.
//
// One spacing system throughout (Theme): every field is a block of a label over its control (label-gap apart),
// and blocks, cards and sections are `gap` apart, with `gap` of padding inside each card and around the window.
import { Button, LineEdit, SpinBox, ComboBox, ListView, Palette } from "std-widgets.slint";

export struct ServerItem {
    name: string,
    address: string,
    selected: bool,
    /// a server the launcher comes with: it can't be renamed or removed
    builtin: bool,
}

/// One arm of the crosshair preview, in the preview's own coordinates
export struct ArmBox {
    x: length,
    y: length,
    width: length,
    height: length,
}

global Theme {
    out property <color> base: #0e0e0e; // near black
    out property <color> card: #ffffff09;
    out property <color> stroke: #ffffff12;
    out property <color> hover: #ffffff0f;
    out property <color> selected: #ffffff17;
    out property <color> secondary: #ffffffa3;
    out property <color> tertiary: #ffffff70;

    out property <length> gap: 12px;         // between blocks, cards and sections; a card's padding
    out property <length> label-gap: 4px;    // between a label and its control
    out property <length> label-height: 16px;
    out property <length> field: 32px;       // a control's height
    out property <length> row: 34px;         // a server's row
    // the crosshair preview spans two blocks' controls: from the first's top to the second's bottom
    out property <length> preview: 2 * field + gap + label-height + label-gap;
}

component GameTab inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <bool> selected;
    in property <bool> available: true;
    callback clicked;

    height: 46px;
    border-radius: 8px;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : Theme.card;
    border-width: 1px;
    border-color: Theme.stroke;
    opacity: root.available ? 1 : 0.4;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding: 5px;
        // the game's icon in a box of its own, lifted off the tab
        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 6px;
            background: root.selected ? #ffffff1f : #ffffff12;
            border-width: 1px;
            border-color: #ffffff1a;
            drop-shadow-blur: 6px;
            drop-shadow-offset-y: 1px;
            drop-shadow-color: #00000080;
            Image {
                source: root.icon;
                width: 24px;
                height: 24px;
            }
        }
        // the name, centered in the rest, and the selection bar as wide as it
        Rectangle {
            horizontal-stretch: 1;
            label := Text {
                x: (parent.width - self.width) / 2;
                width: self.preferred-width;
                text: root.title;
                vertical-alignment: center;
                font-weight: root.selected ? 600 : 400;
                color: Palette.foreground;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 1px;
                width: root.selected ? label.width : 0px;
                height: 3px;
                border-radius: 1.5px;
                background: Palette.accent-background;
                animate width { duration: 160ms; easing: ease-out; }
            }
        }
        // balances the icon's box, so the name sits in the middle of the tab
        Rectangle { width: 12px; }
    }

    touch := TouchArea {
        enabled: root.available;
        mouse-cursor: root.available ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.stroke;

    VerticalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;
        @children
    }
}

component FieldLabel inherits Text {
    height: Theme.label-height;
    vertical-alignment: center;
    color: Theme.secondary;
    font-size: 12px;
}

/// A field: its label over its control
component Field inherits VerticalLayout {
    in property <string> label;
    spacing: Theme.label-gap;
    FieldLabel { text: root.label; }
    @children
}

/// A small action in a field's label row, on the right: an optional icon and a word
component LabelAction inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> active: true; // in the accent color, or (a toggle that's off) in the labels' color
    in property <styled-text> tip;
    callback clicked;

    width: row.preferred-width;
    height: Theme.label-height;
    property <brush> tint: !root.enabled ? Theme.tertiary : touch.has-hover ? Palette.foreground
        : root.active ? Palette.accent-background : Theme.secondary;

    row := HorizontalLayout {
        spacing: 4px;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 12px;
                height: 12px;
                colorize: root.tint;
            }
        }
        Text {
            text: root.text;
            font-size: 12px;
            vertical-alignment: center;
            color: root.tint;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    Tooltip { text: root.tip; }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> accent;
    in property <styled-text> tip;
    callback clicked;

    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: !root.enabled ? transparent : touch.pressed ? Theme.card : touch.has-hover ? Theme.selected : transparent;

    Image {
        source: root.icon;
        width: 15px;
        height: 15px;
        colorize: !root.enabled ? #ffffff38 : root.accent ? Palette.accent-background : #ffffffd0;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tooltip { text: root.tip; }
}

/// An icon that opens a web page
component LinkIcon inherits Rectangle {
    in property <image> icon;
    in property <color> hover-color: Palette.foreground;
    in property <styled-text> tip;
    callback clicked;

    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.hover : transparent;
    Image {
        source: root.icon;
        width: 17px;
        height: 17px;
        colorize: touch.has-hover ? root.hover-color : Theme.secondary;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tooltip { text: root.tip; }
}

component ServerRow inherits Rectangle {
    in property <string> name;
    in property <string> address;
    in property <bool> selected;
    in property <bool> builtin;
    in property <bool> can-start;
    callback clicked;
    callback connect;
    callback rename;
    callback remove;

    height: Theme.row;
    border-radius: 4px;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.connect(); }
    }

    HorizontalLayout {
        padding-left: Theme.gap;
        padding-right: 3px;
        spacing: 2px;
        // two even columns, whatever the texts' lengths
        Text {
            text: root.name;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            color: Palette.foreground;
            font-weight: root.builtin ? 600 : 400;
        }
        Text {
            text: root.name == root.address ? "" : root.address;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            color: Theme.secondary;
        }
        if !root.builtin: VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/edit.svg");
                tip: @markdown("Rename");
                clicked => { root.rename(); }
            }
        }
        if !root.builtin: VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/trash.svg");
                tip: @markdown("Remove");
                clicked => { root.remove(); }
            }
        }
        // the same columns as the other rows, and a pin for a server that stays
        if root.builtin: HorizontalLayout {
            width: 2 * 28px + 2px;
            alignment: end;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    Tooltip { text: @markdown("Always in the list"); }
                    Image {
                        source: @image-url("icons/pin.svg");
                        width: 13px;
                        height: 13px;
                        colorize: Theme.tertiary;
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/play.svg");
                tip: @markdown("Join");
                accent: true;
                enabled: root.can-start;
                clicked => { root.connect(); }
            }
        }
    }
}

component CrosshairPreview inherits Rectangle {
    in property <[ArmBox]> arms;
    in property <color> arm-color;
    in property <bool> dark-color;

    width: Theme.preview;
    height: Theme.preview;
    border-radius: 6px;
    clip: true;
    // the game's sky or a wall behind it: black, grey for a dark crosshair
    background: root.dark-color ? #808080 : #000000;
    border-width: 1px;
    border-color: Theme.stroke;

    for arm in root.arms: Rectangle {
        x: arm.x;
        y: arm.y;
        width: arm.width;
        height: arm.height;
        background: root.arm-color;
    }
}

export component LauncherWindow inherits Window {
    title: "MoHAA Launcher";
    icon: @image-url("../../assets/app-icon-128.png");
    background: Theme.base;
    // as big as the contents, no bigger
    max-width: main-layout.preferred-width;
    max-height: main-layout.preferred-height;

    // the game
    in property <int> game;
    in property <bool> sh-available: true;
    in property <bool> bt-available: true;
    in property <string> status;
    in property <bool> status-warning; // the status says what stands in the way
    in property <bool> can-start;
    in property <bool> can-connect;
    in property <bool> running;

    // the player and the servers
    in-out property <string> name;
    in property <bool> discord-presence;
    in-out property <string> address;
    in-out property <string> password;
    in-out property <string> rcon;
    in property <[ServerItem]> servers;
    in property <bool> bookmarked;   // the server in the fields is in the list
    in property <bool> can-bookmark;

    // the crosshair
    in-out property <int> length: 4;
    in-out property <int> gap: 3;
    in-out property <int> thickness: 1;
    in property <[string]> color-names;
    in-out property <int> color-index;
    in property <color> crosshair-color: white;
    in property <bool> crosshair-dark;
    in property <[ArmBox]> arms;

    // the display
    in property <[string]> resolutions;
    in-out property <int> resolution-index;
    in property <[string]> modes;
    in-out property <int> mode-index;

    // a message or a question over the window
    in property <bool> dialog-visible;
    in property <string> dialog-title;
    in property <string> dialog-text;
    in property <bool> dialog-input;
    in-out property <string> dialog-value;
    in property <string> dialog-ok: "OK";
    in property <string> dialog-cancel;

    callback select-game(int);
    callback name-edited(string);
    callback discord-presence-toggled();
    callback address-edited(string);
    callback password-edited(string);
    callback rcon-edited(string);
    callback bookmark();
    callback server-clicked(int);
    callback server-connect(int);
    callback server-rename(int);
    callback server-remove(int);
    callback length-edited(int);
    callback gap-edited(int);
    callback thickness-edited(int);
    callback color-selected(int);
    callback reset-crosshair();
    callback resolution-selected(int);
    callback mode-selected(int);
    callback choose-folder();
    callback open-url(string);
    callback single-player();
    callback connect();
    callback dialog-accepted();
    callback dialog-cancelled();
    // the game quit (from the thread that waited for it)
    callback game-exited();

    main-layout := VerticalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;

        HorizontalLayout {
            spacing: Theme.gap / 2;
            GameTab {
                icon: @image-url("../../assets/game-aa-64.png");
                title: "Allied Assault";
                selected: root.game == 0;
                clicked => { root.select-game(0); }
            }
            GameTab {
                icon: @image-url("../../assets/game-sh-64.png");
                title: "Spearhead";
                selected: root.game == 1;
                available: root.sh-available;
                clicked => { root.select-game(1); }
            }
            GameTab {
                icon: @image-url("../../assets/game-bt-64.png");
                title: "Breakthrough";
                selected: root.game == 2;
                available: root.bt-available;
                clicked => { root.select-game(2); }
            }
        }

        // the player, the server and the servers played on
        Card {
            GridLayout {
                spacing: Theme.gap;
                Row {
                    VerticalLayout {
                        spacing: Theme.label-gap;
                        HorizontalLayout {
                            FieldLabel {
                                text: "Player name";
                                horizontal-stretch: 1;
                            }
                            LabelAction {
                                icon: root.discord-presence ? @image-url("icons/checkbox-checked.svg")
                                    : @image-url("icons/checkbox.svg");
                                text: "Discord presence";
                                active: root.discord-presence;
                                tip: @markdown("Show what you play on your Discord profile while Discord runs (cl_discordPresence)");
                                clicked => { root.discord-presence-toggled(); }
                            }
                        }
                        LineEdit {
                            text <=> root.name;
                            placeholder-text: "UnnamedSoldier";
                            edited(text) => { root.name-edited(text); }
                        }
                    }
                    VerticalLayout {
                        spacing: Theme.label-gap;
                        HorizontalLayout {
                            FieldLabel {
                                text: "Server";
                                horizontal-stretch: 1;
                            }
                            LabelAction {
                                icon: root.bookmarked ? @image-url("icons/bookmark-filled.svg")
                                    : @image-url("icons/bookmark.svg");
                                text: root.bookmarked ? "Bookmarked" : "Bookmark";
                                enabled: root.can-bookmark;
                                tip: root.bookmarked ? @markdown("In the list: click to keep its passwords too")
                                    : @markdown("Add it to the list without joining");
                                clicked => { root.bookmark(); }
                            }
                        }
                        LineEdit {
                            text <=> root.address;
                            placeholder-text: "host:port";
                            edited(text) => { root.address-edited(text); }
                            accepted(text) => { root.connect(); }
                        }
                    }
                }
                Row {
                    Field {
                        label: "Server password";
                        LineEdit {
                            text <=> root.password;
                            input-type: InputType.password;
                            placeholder-text: "If the server has one";
                            edited(text) => { root.password-edited(text); }
                            accepted(text) => { root.connect(); }
                        }
                    }
                    Field {
                        label: "RCON password";
                        LineEdit {
                            text <=> root.rcon;
                            input-type: InputType.password;
                            placeholder-text: "For server admins";
                            edited(text) => { root.rcon-edited(text); }
                            accepted(text) => { root.connect(); }
                        }
                    }
                }
            }
            Rectangle {
                height: 3 * Theme.row + 4px;
                border-radius: 6px;
                background: #00000030;
                border-width: 1px;
                border-color: #ffffff0a;
                ListView {
                    for server[i] in root.servers: ServerRow {
                        name: server.name;
                        address: server.address;
                        selected: server.selected;
                        builtin: server.builtin;
                        can-start: root.can-start;
                        clicked => { root.server-clicked(i); }
                        connect => { root.server-connect(i); }
                        rename => { root.server-rename(i); }
                        remove => { root.server-remove(i); }
                    }
                }
                // the room the list doesn't fill yet
                if root.servers.length < 3: Text {
                    y: root.servers.length * Theme.row + 2px;
                    height: parent.height - self.y;
                    width: parent.width;
                    text: root.servers.length == 0
                        ? "The servers you join are kept here: double-click one to join it again."
                        : "The servers you join are kept here.";
                    font-size: 12px;
                    color: Theme.tertiary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.gap;

            // the crosshair: its preview, as tall as the two rows of fields beside it
            Card {
                HorizontalLayout {
                    spacing: Theme.gap;
                    VerticalLayout {
                        spacing: Theme.label-gap;
                        HorizontalLayout {
                            FieldLabel {
                                text: "Crosshair";
                                horizontal-stretch: 1;
                            }
                            LabelAction {
                                text: "Reset";
                                tip: @markdown("The stock crosshair: length 4, gap 3, thickness 1, white");
                                clicked => { root.reset-crosshair(); }
                            }
                        }
                        CrosshairPreview {
                            arms: root.arms;
                            arm-color: root.crosshair-color;
                            dark-color: root.crosshair-dark;
                        }
                    }
                    GridLayout {
                        spacing: Theme.gap;
                        Row {
                            Field {
                                label: "Length";
                                SpinBox {
                                    height: Theme.field;
                                    minimum: 1;
                                    maximum: 128;
                                    value <=> root.length;
                                    edited(value) => { root.length-edited(value); }
                                }
                            }
                            Field {
                                label: "Gap";
                                SpinBox {
                                    height: Theme.field;
                                    minimum: 1;
                                    maximum: 64;
                                    value <=> root.gap;
                                    edited(value) => { root.gap-edited(value); }
                                }
                            }
                        }
                        Row {
                            Field {
                                label: "Thickness";
                                SpinBox {
                                    height: Theme.field;
                                    minimum: 1;
                                    maximum: 16;
                                    value <=> root.thickness;
                                    edited(value) => { root.thickness-edited(value); }
                                }
                            }
                            Field {
                                label: "Color";
                                ComboBox {
                                    height: Theme.field;
                                    model: root.color-names;
                                    current-index <=> root.color-index;
                                    selected(value) => { root.color-selected(self.current-index); }
                                }
                            }
                        }
                    }
                }
            }

            // the display
            Card {
                Field {
                    label: "Resolution";
                    ComboBox {
                        height: Theme.field;
                        model: root.resolutions;
                        current-index <=> root.resolution-index;
                        selected(value) => { root.resolution-selected(self.current-index); }
                    }
                }
                Field {
                    label: "Display mode";
                    ComboBox {
                        height: Theme.field;
                        model: root.modes;
                        current-index <=> root.mode-index;
                        selected(value) => { root.mode-selected(self.current-index); }
                    }
                }
            }
        }

        // the project's links, where the game is (a click changes it), and the buttons
        HorizontalLayout {
            spacing: Theme.gap / 2;
            VerticalLayout {
                alignment: center;
                LinkIcon {
                    icon: @image-url("../../assets/github.svg");
                    tip: @markdown("MoHAA Reloaded on GitHub");
                    clicked => { root.open-url("https://github.com/pstngh/MoHAA-Reloaded"); }
                }
            }
            VerticalLayout {
                alignment: center;
                LinkIcon {
                    icon: @image-url("../../assets/discord.svg");
                    hover-color: #5865f2; // Discord's blurple
                    tip: @markdown("Forte's Discord");
                    clicked => { root.open-url("https://dsc.gg/ForteFFA"); }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                border-radius: 4px;
                background: folder-touch.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        if !root.running: Image {
                            source: @image-url("icons/folder.svg");
                            width: 14px;
                            height: 14px;
                            colorize: root.status-warning ? #fcc33d : Theme.secondary;
                        }
                        if root.running: Rectangle {
                            width: 14px;
                            height: 14px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #6ccb5f;
                            }
                        }
                    }
                    Text {
                        text: root.status;
                        font-size: 12px;
                        color: root.status-warning ? #fcc33d : Theme.secondary;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                    }
                }
                folder-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.choose-folder(); }
                }
                Tooltip { text: @markdown("The game folder: click to choose another"); }
            }
            Rectangle { width: Theme.gap / 2; }
            Button {
                text: "Single player";
                icon: @image-url("icons/person.svg");
                colorize-icon: true;
                enabled: root.can-start;
                clicked => { root.single-player(); }
            }
            Button {
                min-width: 120px;
                text: "Connect";
                icon: @image-url("icons/play.svg");
                colorize-icon: true;
                primary: true;
                enabled: root.can-connect;
                clicked => { root.connect(); }
            }
        }
    }

    // a message or a question, over the window
    if root.dialog-visible: Rectangle {
        background: #00000099;
        TouchArea { }
        // Esc cancels, Enter confirms (a field's own Enter too)
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.dialog-cancel != "" ? root.dialog-cancelled() : root.dialog-accepted();
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.dialog-accepted();
                    return accept;
                }
                reject
            }
            Rectangle {
                width: min(400px, parent.width - 2 * Theme.gap);
                height: dialog-layout.preferred-height;
                background: #2c2c2c;
                border-radius: 8px;
                border-width: 1px;
                border-color: #ffffff1a;
                drop-shadow-blur: 32px;
                drop-shadow-color: #00000080;
                dialog-layout := VerticalLayout {
                    padding: 2 * Theme.gap;
                    spacing: Theme.gap;
                    Text {
                        text: root.dialog-title;
                        font-size: 17px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }
                    Text {
                        text: root.dialog-text;
                        wrap: word-wrap;
                        color: Palette.foreground;
                    }
                    if root.dialog-input: LineEdit {
                        text <=> root.dialog-value;
                        accepted(text) => { root.dialog-accepted(); }
                        init => { self.focus(); }
                    }
                    HorizontalLayout {
                        spacing: Theme.gap / 1.5;
                        alignment: end;
                        if root.dialog-cancel != "": Button {
                            text: root.dialog-cancel;
                            clicked => { root.dialog-cancelled(); }
                        }
                        Button {
                            text: root.dialog-ok;
                            primary: true;
                            clicked => { root.dialog-accepted(); }
                        }
                    }
                }
            }
        }
    }
}
